{
  "id": "long-night",
  "title": "The Long Night",
  "summary": "The long playtest level: a quiet run along the Wall, then eleven stretches across the whole city, about 5-10 minutes. A convoy, a river with three crossings, an optional target, and a crew decision before the fortress.",
  "level": "long-night",
  "briefing": "Vostravan armour has no business inside the Directorate's wall, and its border troops know it. Cross the city to the fortress at the far end and get out through its west yard. The Wall road first, then old town, the boulevard, the factory, the river, the rail yard, the border checkpoint, then the fortress itself. Every stretch has a way around its guards, and the crew patches the tank at each checkpoint. A signal truck at the factory can call reinforcements to the fortress if they know you're coming. Taking it out is optional.",
  "playerName": "Ironveil",
  "alarmRadius": 520,
  "units": [
    { "id": "ot_church", "name": "Church Corner", "marker": "ot_church", "ai": "simple", "skill": 0.4 },
    { "id": "ot_plaza", "name": "Plaza Post", "marker": "ot_plaza", "ai": "simple", "skill": 0.4 },
    { "id": "ot_lane", "name": "Lane Patrol", "marker": "ot_lane_start", "ai": "simple", "posture": { "patrol": "ot_lane" }, "skill": 0.4 },
    { "id": "convoy_lead", "name": "Convoy Lead", "marker": "conv_a", "ai": "simple", "posture": { "patrol": "convoy_a" }, "skill": 0.45 },
    { "id": "convoy_tail", "name": "Convoy Tail", "marker": "conv_b", "ai": "simple", "posture": { "patrol": "convoy_b" }, "skill": 0.45 },
    { "id": "fac_gate", "name": "Factory Gate", "marker": "fac_gate", "ai": "simple", "skill": 0.45 },
    { "id": "signal_truck", "name": "Signal Truck", "marker": "fac_truck", "ai": "simple", "skill": 0.3 },
    { "id": "fac_yard", "name": "Yard Patrol", "marker": "fac_yard_start", "ai": "simple", "posture": { "patrol": "fac_yard" }, "skill": 0.45 },
    { "id": "riv_north", "name": "North Bridge", "marker": "riv_north", "ai": "simple", "skill": 0.45 },
    { "id": "riv_south", "name": "South Bridge", "marker": "riv_south", "ai": "simple", "skill": 0.45 },
    { "id": "riv_bank", "name": "Bank Patrol", "marker": "riv_bank_start", "ai": "simple", "posture": { "patrol": "riv_bank" }, "skill": 0.45 },
    { "id": "ry_tower", "name": "Signal Tower", "marker": "ry_tower", "ai": "simple", "skill": 0.5 },
    { "id": "ry_west", "name": "Sidings West", "marker": "ry_west_start", "ai": "simple", "posture": { "patrol": "ry_west" }, "skill": 0.5 },
    { "id": "ry_east", "name": "Sidings East", "marker": "ry_east_start", "ai": "simple", "posture": { "patrol": "ry_east" }, "skill": 0.5 },
    { "id": "bc_gate_n", "name": "Border Gate N", "marker": "bc_gate_n", "ai": "simple", "skill": 0.5 },
    { "id": "bc_gate_s", "name": "Border Gate S", "marker": "bc_gate_s", "ai": "simple", "skill": 0.5 },
    { "id": "bc_ruins", "name": "Ruins Patrol", "marker": "bc_ruins_start", "ai": "simple", "posture": { "patrol": "bc_ruins" }, "skill": 0.5 },
    { "id": "fo_gate_n", "name": "Fortress Gate N", "marker": "fo_gate_n", "ai": "simple", "skill": 0.55 },
    { "id": "fo_gate_s", "name": "Fortress Gate S", "marker": "fo_gate_s", "ai": "simple", "skill": 0.55 },
    { "id": "fo_culvert", "name": "Culvert Watch", "marker": "fo_culvert", "ai": "simple", "posture": { "patrol": "fo_culvert_walk" }, "skill": 0.5 },
    { "id": "fo_keep", "name": "Keep Patrol", "marker": "fo_keep_start", "ai": "simple", "posture": { "patrol": "fo_keep" }, "skill": 0.55 },
    { "id": "fo_inner", "name": "Inner Yard", "marker": "fo_inner", "ai": "simple", "skill": 0.55 }
  ],
  "objectives": [
    { "id": "o_town", "text": "Get through the old town" },
    { "id": "o_boulevard", "text": "Cross the boulevard", "state": "hidden" },
    { "id": "o_factory", "text": "Get past the factory", "state": "hidden" },
    { "id": "o_river", "text": "Cross the river", "state": "hidden" },
    { "id": "o_rail", "text": "Cross the rail yard", "state": "hidden" },
    { "id": "o_border", "text": "Get through the border checkpoint", "state": "hidden" },
    { "id": "o_fortress", "text": "Reach the extraction yard inside the fortress", "state": "hidden" },
    { "id": "opt_truck", "text": "Knock out the signal truck (optional)", "state": "hidden" },
    { "id": "stay_hidden", "text": "Stay undetected (optional)" }
  ],
  "triggers": [
    {
      "id": "intro",
      "when": { "after": 1 },
      "do": [
        { "radio": "Tank 412, inside the Wall. Their city ahead, their fortress at its far end. We cross it tonight.", "from": "Commander" },
        { "radio": "My grandmother was born here, before the Wall.", "from": "Gunner" },
        { "radio": "The Directorate stamps everything. Tonight we go unstamped.", "from": "Loader" },
        { "radio": "Quiet where we can, comrades. Then home.", "from": "Commander" }
      ]
    },
    {
      "id": "first_contact",
      "when": { "all": [{ "enter": "wall_end" }, { "after": 22, "since": "intro" }] },
      "do": [
        { "checkpoint": "cp_garage" },
        { "spawn": { "id": "allot_watch", "name": "Allotment Watch", "marker": "allot_gate", "ai": "simple", "posture": { "patrol": "allot_walk" }, "skill": 0.3 } },
        { "bark": "Contact. One patrol, coming up the road.", "from": "Gunner" },
        { "bark": "Hedges both sides. Shift runs us silent.", "from": "Driver", "delay": 4 }
      ]
    },
    {
      "id": "allotments",
      "when": { "enter": "allotments" },
      "do": [
        { "bark": "Hedges hide us. Keep your distance.", "from": "Gunner" }
      ]
    },
    {
      "id": "cp_oldtown",
      "when": { "enter": "z_oldtown" },
      "do": [
        { "checkpoint": "cp_oldtown" },
        { "repair": true },
        { "bark": "Old town. Short sightlines.", "from": "Gunner" },
        { "bark": "Church blocks the street. North, or the south lanes.", "from": "Driver", "delay": 4 }
      ]
    },
    {
      "id": "oldtown",
      "when": { "enter": "oldtown" },
      "do": [
        { "bark": "Slow at the corners, Pasha.", "from": "Commander" }
      ]
    },
    {
      "id": "cp_boulevard",
      "when": { "enter": "z_boulevard" },
      "do": [
        { "objective": "o_town", "state": "complete" },
        { "objective": "o_boulevard", "state": "active" },
        { "checkpoint": "cp_boulevard" },
        { "repair": true },
        { "bark": "Boulevard. Two tanks lapping the arcade.", "from": "Gunner" },
        { "bark": "Let them pass. Cross behind.", "from": "Commander", "delay": 4 }
      ]
    },
    {
      "id": "boulevard_far",
      "when": { "enter": "boulevard_far" },
      "do": [
        { "bark": "Road turns south at the gatehouse.", "from": "Driver" }
      ]
    },
    {
      "id": "cp_factory",
      "when": { "enter": "z_factory" },
      "do": [
        { "objective": "o_boulevard", "state": "complete" },
        { "objective": "o_factory", "state": "active" },
        { "objective": "opt_truck", "state": "active" },
        { "checkpoint": "cp_factory" },
        { "repair": true },
        { "bark": "Factory. One on the gate, one in the yard.", "from": "Gunner" },
        { "bark": "Signal truck in the yard. It calls the fortress.", "from": "Loader", "delay": 4 },
        { "bark": "Alleys north and south. Your call.", "from": "Commander", "delay": 8 }
      ]
    },
    {
      "id": "factory_yard",
      "when": { "enter": "factory_yard" },
      "do": [
        { "bark": "Truck's by the generator. Thin armour.", "from": "Gunner" }
      ]
    },
    {
      "id": "truck_down",
      "when": { "destroyed": "signal_truck" },
      "do": [
        { "objective": "opt_truck", "state": "complete" },
        { "bark": "Truck's down. Let them file a complaint.", "from": "Loader" }
      ]
    },
    {
      "id": "cp_river",
      "when": { "enter": "z_river" },
      "do": [
        { "objective": "o_factory", "state": "complete" },
        { "objective": "o_river", "state": "active" },
        { "checkpoint": "cp_river" },
        { "repair": true },
        { "bark": "River. Both bridges watched.", "from": "Gunner" },
        { "bark": "Or the ford. Slow, loud, a patrol on the far bank.", "from": "Driver", "delay": 4 }
      ]
    },
    {
      "id": "river",
      "when": { "enter": "river" },
      "do": [
        { "bark": "Steady, Pasha. Revs down on the water.", "from": "Commander" }
      ]
    },
    {
      "id": "cp_park",
      "when": { "enter": "z_park" },
      "do": [
        { "objective": "o_river", "state": "complete" },
        { "objective": "o_rail", "state": "active" },
        { "checkpoint": "cp_park" },
        { "repair": true },
        { "bark": "Park's clear. Breathe.", "from": "Commander" },
        { "bark": "Halfway. Vostravan steel holds.", "from": "Driver", "delay": 4 }
      ]
    },
    {
      "id": "cp_railyard",
      "when": { "enter": "z_railyard" },
      "do": [
        { "checkpoint": "cp_railyard" },
        { "repair": true },
        { "bark": "Rail yard. Two patrols in the sidings.", "from": "Gunner" },
        { "bark": "Overgrown tracks along both fences.", "from": "Driver", "delay": 4 }
      ]
    },
    {
      "id": "cp_border",
      "when": { "enter": "z_border" },
      "do": [
        { "objective": "o_rail", "state": "complete" },
        { "objective": "o_border", "state": "active" },
        { "checkpoint": "cp_border" },
        { "repair": true },
        { "bark": "Checkpoint. Two on the gate, stamping papers.", "from": "Gunner" },
        { "bark": "Wall's breached south. Someone walks the ruins.", "from": "Driver", "delay": 4 }
      ]
    },
    {
      "id": "past_border",
      "when": { "enter": "past_border" },
      "do": [
        { "bark": "Through. Road turns south.", "from": "Driver" }
      ]
    },
    {
      "id": "cp_approach",
      "when": { "enter": "z_approach" },
      "do": [
        { "objective": "o_border", "state": "complete" },
        { "objective": "o_fortress", "state": "active" },
        { "checkpoint": "cp_approach" },
        { "repair": true },
        { "bark": "Fortress, west. Gate on the road, culvert south.", "from": "Gunner" },
        { "bark": "One flare. Say where, I pull them off.", "from": "Loader", "delay": 4 }
      ]
    },
    {
      "id": "flare",
      "when": { "enter": "approach_choice" },
      "do": [
        {
          "choice": {
            "from": "Loader",
            "prompt": "Where does the flare go?",
            "timeout": 20,
            "default": 2,
            "options": [
              {
                "text": "Over the culvert. Draw the gate crew south",
                "do": [
                  {
                    "setFlag": "flare",
                    "value": "culvert"
                  },
                  {
                    "order": "fo_gate_n",
                    "posture": {
                      "patrol": "fo_flare_south"
                    }
                  },
                  {
                    "order": "fo_gate_s",
                    "posture": {
                      "patrol": "fo_flare_south"
                    }
                  },
                  {
                    "bark": "Flare's away. Gate crew's rolling south.",
                    "from": "Loader"
                  },
                  {
                    "bark": "Front door, then. Quick, before they come back.",
                    "from": "Commander",
                    "delay": 3
                  }
                ]
              },
              {
                "text": "Over the gate. Draw the culvert watch north",
                "do": [
                  {
                    "setFlag": "flare",
                    "value": "gate"
                  },
                  {
                    "order": "fo_culvert",
                    "posture": {
                      "guard": "fo_flare_gate"
                    }
                  },
                  {
                    "bark": "Flare's away. Culvert watch is moving up.",
                    "from": "Loader"
                  },
                  {
                    "bark": "Mud and darkness it is. Pasha, south.",
                    "from": "Commander",
                    "delay": 3
                  }
                ]
              },
              {
                "text": "Save it. We go as we are",
                "do": [
                  {
                    "setFlag": "flare",
                    "value": "none"
                  },
                  {
                    "bark": "Keeping it. Might need it.",
                    "from": "Loader"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "fortress",
      "when": { "enter": "fortress" },
      "do": [
        { "bark": "Inside. West yard, past the keep. Then home.", "from": "Commander" }
      ]
    },
    {
      "id": "fortress_reinforced",
      "when": { "all": [{ "alarm": true }, { "enter": "fortress" }, { "not": { "destroyed": "signal_truck" } }] },
      "do": [
        { "bark": "They knew. Reserves in the west yard!", "from": "Gunner" },
        { "spawn": { "id": "fo_qrf", "name": "Fortress Reserve", "marker": "fo_qrf", "ai": "simple", "skill": 0.6 } }
      ]
    },
    {
      "id": "spotted",
      "when": { "alarm": true },
      "do": [
        { "objective": "stay_hidden", "state": "failed" },
        { "bark": "Seen! Finish it or break contact.", "from": "Commander" }
      ]
    },
    {
      "id": "extract_clean",
      "when": { "all": [{ "enter": "extraction" }, { "not": { "alarm": true } }] },
      "do": [
        { "objective": "o_fortress", "state": "complete" },
        { "objective": "stay_hidden", "state": "complete" },
        { "end": "success", "text": "Across the whole city and out the back of their fortress. Nobody saw a thing. The Directorate will be filing reports for a month." }
      ]
    },
    {
      "id": "extract_loud",
      "when": { "all": [{ "enter": "extraction" }, { "alarm": true }] },
      "do": [
        { "objective": "o_fortress", "state": "complete" },
        { "end": "success", "text": "We made it out. The whole city knows a Vostravan tank was here." }
      ]
    }
  ]
}
